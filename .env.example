# Copy to .env and fill in. Plain KEY=value lines, no quotes: the Makefile includes the file.
# Leave out keys you do not have yet; an empty value reaches Terraform as an empty string.

# Azure subscription; Terraform signs in with the current `az login` session.
ARM_SUBSCRIPTION_ID=

# shared-up: sign-in redirect URI of the app on AKS
TF_VAR_aks_hostname=

# aks-up: DNS record and certificate of the app
TF_VAR_hostname=
TF_VAR_cloudflare_zone_id=
# DNS edit rights on the zone
TF_VAR_cloudflare_api_token=
TF_VAR_budget_contact_email=
